<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VARK Learning Style Certificate</title>
  
  <!-- ApexCharts CDN -->
  <script src="https://cdn.jsdelivr.net/npm/apexcharts@latest"></script>
  
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Arial', sans-serif;
      background-color: #f5f5f5;
      color: #333;
      line-height: 1.4;
    }
    
    .certificate-container {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      background: white;
      position: relative;
      overflow: hidden;
    }
    
    /* Header Section */
    .header {
      background: linear-gradient(135deg, #84d63b 0%, #6bb329 100%);
      color: white;
      padding: 20px 40px;
      position: relative;
    }
    
    .header::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 20px;
      background: linear-gradient(45deg, transparent 49%, white 50%, transparent 51%);
    }
    
    .logo {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    
    .logo-text {
      font-size: 24px;
      font-weight: bold;
    }
    
    .logo-symbol {
      width: 30px;
      height: 30px;
      background: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #84d63b;
      font-weight: bold;
    }
    
    .report-type {
      text-align: right;
      margin-top: 10px;
    }
    
    .report-title {
      font-size: 14px;
      font-weight: normal;
    }
    
    .report-subtitle {
      font-size: 12px;
      opacity: 0.9;
    }
    
    /* Main Content */
    .main-content {
      padding: 40px;
    }
    
    .date-info {
      text-align: left;
      margin-bottom: 20px;
      font-size: 12px;
      color: #666;
    }
    
    /* Two-column layout for main certificate section */
    .certificate-main {
      display: flex;
      gap: 30px;
      margin-bottom: 40px;
      align-items: flex-start;
    }
    
    .certificate-info {
      flex: 1;
    }
    
    .certificate-title {
      font-size: 32px;
      color: #4a5568;
      font-weight: bold;
      margin-bottom: 25px;
      text-align: left;
    }
    
    .participant-info {
      margin-bottom: 20px;
    }
    
    .participant-info p {
      margin-bottom: 8px;
      font-size: 16px;
    }
    
    .participant-info strong {
      color: #2d3748;
    }
    
    /* Score Section */
    .total-score-section {
      flex-shrink: 0;
      text-align: center;
    }
    
    .total-score-title {
      background: #84d63b;
      color: white;
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 14px;
      font-weight: bold;
      margin-bottom: 15px;
      display: inline-block;
    }
    
    .total-score-chart-container {
      background: white;
      border: 2px solid #84d63b;
      border-radius: 12px;
      padding: 20px;
      width: 280px;
      height: 280px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .total-score-chart-container #totalScoreChart {
      width: 100%;
      height: 100%;
    }
    
    /* Learning Style Section */
    .learning-style-section {
      margin: 40px 0;
    }
    
    .section-title {
      font-size: 28px;
      color: #4a5568;
      text-align: center;
      margin-bottom: 30px;
      font-weight: bold;
    }
    
    .primary-style-container {
      display: flex;
      justify-content: flex-start;
      align-items: flex-start;
      gap: 30px;
    }
    
    .primary-style-content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      max-width: 700px;
    }
    
    .style-score-badge {
      background: #84d63b;
      color: white;
      padding: 8px 15px;
      border-radius: 20px;
      font-size: 14px;
      font-weight: bold;
      margin-bottom: 20px;
    }
    
    .style-chart-box {
      background: white;
      border: 2px solid #84d63b;
      border-radius: 12px;
      padding: 15px;
      width: 200px;
      height: 200px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
      float: left;
      margin-right: 25px;
    }
    
    .style-chart-box #primaryStyleChart {
      width: 100%;
      height: 100%;
    }
    
    .style-description {
      font-size: 14px;
      line-height: 1.6;
      color: #4a5568;
      text-align: justify;
      clear: left;
    }
    
    /* Other Scores Section */
    .other-scores-section {
      margin: 40px 0;
    }
    
    .scores-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
      margin-top: 20px;
    }
    
    .score-item {
      text-align: center;
    }
    
    .score-label {
      background: #84d63b;
      color: white;
      padding: 6px 12px;
      border-radius: 15px;
      font-size: 12px;
      font-weight: bold;
      margin-bottom: 15px;
      display: inline-block;
    }
    
    .score-chart-container {
      background: white;
      border: 2px solid #84d63b;
      border-radius: 12px;
      padding: 15px;
      width: 160px;
      height: 160px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .score-chart-container > div {
      width: 100%;
      height: 100%;
    }
    
    /* Signature Section */
    .signature-section {
      position: absolute;
      bottom: 40px;
      right: 40px;
      text-align: center;
    }
    
    .signature-line {
      border-bottom: 2px solid #333;
      width: 200px;
      margin-bottom: 10px;
    }
    
    .signature-image {
      margin-bottom: 10px;
    }
    
    .signature-image img {
      max-width: 150px;
      max-height: 60px;
      object-fit: contain;
      filter: contrast(1.2);
    }
    
    .signature-name {
      font-weight: bold;
      font-size: 14px;
      margin-bottom: 5px;
    }
    
    .signature-title {
      font-size: 12px;
      color: #666;
    }
    
    /* Print Styles */
    @media print {
      body {
        background: white;
      }
      
      .certificate-container {
        width: 100%;
        min-height: 100vh;
        margin: 0;
        box-shadow: none;
      }
    }
  </style>
</head>
<body>
  <%= yield %>
</body>
</html>
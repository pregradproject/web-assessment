<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cakravia Official Score Report</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Merriweather+Sans:wght@300;400;700;800&display=block" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Merriweather+Sans:wght@300;400;700;800&display=block');
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/apexcharts/4.7.0/apexcharts.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        @page {
            margin: 0;
            padding: 0;
            size: A4;
        }

        html, body {
            font-family: 'Merriweather Sans', 'Open Sans', 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
            margin: 0;
            padding: 0;
            color: #24348C;
            width: 100%;
            height: 100%;
            box-sizing: border-box;
        }

        *, h1, h2, h3, h4, h5, h6, p, div, span {
            font-family: 'Merriweather Sans', 'Open Sans', 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif !important;
            color: #24348C !important;
        }

        .header {
            background: #ABD305;
            color: #24348C;
            padding: 18px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: #9ed442;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: #24348C;
        }

        .logo-text {
            font-size: 16px;
            font-weight: bold;
        }

        .report-title {
            text-align: right;
        }

        .report-title h1 {
            font-size: 18px;
            margin-bottom: 3px;
        }

        .certificate-id {
            font-size: 10px;
            opacity: 0.9;
        }

        .main-content {
            padding: 0;
        }

        .certificate-section {
            background: url('<%= @background_image_path %>');
            background-size: cover;
            background-position: center;
            padding: 25px 30px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 0;
            position: relative;
        }

        .certificate-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: #DFE4FF;
            opacity: 0.8;
            z-index: 1;
        }

        .certificate-section > * {
            position: relative;
            z-index: 2;
        }

        .certificate-info {
            flex: 7;
        }

        .date {
            color: #24348C;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .certificate-title {
            font-size: 24px;
            color: #24348C;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .student-info {
            font-size: 14px;
            line-height: 1.4;
        }

        .student-info strong {
            color: #24348C;
        }

        .score-circle {
            flex: 5;
            width: auto;
            max-width: none;
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            padding: 20px;
            position: relative;
            margin-left: 20px;
        }

        .score-widget {
            width: 100%;
            height: 100%;
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .score-title {
            background: #9ed442;
            color: white;
            padding: 8px 24px;
            border-radius: 15px;
            font-size: 14px;
            font-weight: bold;
            position: absolute;
            top: -15px;
            left: 50%;
            transform: translateX(-50%);
            white-space: nowrap;
        }

        .chart-placeholder {
            width: 160px;
            height: 160px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .chart-container {
            width: 180px;
            height: 180px;
        }

        .small-chart-container {
            width: 170px;
            height: 170px;
        }

        .learning-style-section {
            margin: 0;
            padding: 25px 30px;
        }

        .section-title {
            font-size: 20px;
            color: #24348C;
            font-weight: bold;
            text-align: center;
            margin-bottom: 22px;
        }

        .learning-style-content {
            display: flex;
            gap: 20px;
            align-items: flex-start;
        }

        .reading-score {
            width: 200px;
            height: 200px;
            position: relative;
            flex-shrink: 0;
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            padding: 15px;
        }

        .reading-widget {
            width: 100%;
            height: 100%;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .dominant-score-title {
            color: white;
            padding: 8px 16px;
            border-radius: 15px;
            font-size: 14px;
            font-weight: bold;
            position: absolute;
            top: -20px;
            left: 50%;
            transform: translateX(-50%);
            white-space: nowrap;
        }

        .style-description {
            flex: 1;
        }

        .style-description h3 {
            font-size: 16px;
            color: #24348C;
            margin-bottom: 8px;
        }

        .style-description p {
            line-height: 1.4;
            margin-bottom: 10px;
            color: #24348C;
            font-size: 13px;
        }

        .other-scores-section {
            background: url('<%= @background_image_path %>');
            background-size: cover;
            background-position: center;
            padding: 25px 30px;
            margin: 0;
            position: relative;
        }

        .other-scores-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: #DFE4FF;
            opacity: 0.8;
            z-index: 1;
        }

        .other-scores-section > * {
            position: relative;
            z-index: 2;
        }

        .scores-grid {
            display: flex;
            gap: 20px;
            justify-content: center;
        }

        .score-item {
            width: 200px;
            height: 200px;
            position: relative;
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            padding: 15px;
        }

        .score-item-widget {
            width: 100%;
            height: 100%;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .score-item-title {
            color: white;
            padding: 6px 12px;
            border-radius: 15px;
            font-size: 12px;
            font-weight: bold;
            position: absolute;
            top: -20px;
            left: 50%;
            transform: translateX(-50%);
            white-space: nowrap;
        }

        .visual-score-title { background: #8979FF; }
        .auditory-score-title { background: #FF928A; }
        .kinesthetic-score-title { background: #FFAE4C; }

        .signature-section {
            text-align: center;
            padding: 30px 30px 25px 30px;
            border-top: 1px solid #e9ecef;
            background: white;
        }

        .validation-text {
            font-size: 11px;
            color: #24348C;
            margin-bottom: 15px;
        }

        .signature {
            font-size: 20px;
            font-style: italic;
            color: #24348C;
            margin-bottom: 8px;
        }

        .signature-name {
            font-weight: bold;
            color: #24348C;
        }

        .signature-title {
            font-size: 11px;
            color: #24348C;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo">
            <div class="logo-icon">b</div>
            <div class="logo-text">logoipsum</div>
        </div>
        <div class="report-title">
            <h1>Cakravia Official Score Report</h1>
            <div class="certificate-id">Certificate ID: <%= @certificate_id %></div>
        </div>
    </div>

    <div class="main-content">
        <div class="certificate-section">
            <div class="certificate-info">
                <div class="date"><%= @current_date %></div>
                <h2 class="certificate-title">Certificate of Completion</h2>
                <div class="student-info">
                    <div><strong>Name:</strong> <%= @user_name %></div>
                    <div><strong>Date of Birth:</strong> <%= @birth_date %></div>
                    <div><strong>Test Date:</strong> <%= @test_date %></div>
                </div>
            </div>
            <div class="score-circle total-score">
                <div class="score-title">Total Learning Score</div>
                <div class="score-widget">
                    <div class="chart-container" id="totalChart"></div>
                </div>
            </div>
        </div>

        <div class="learning-style-section">
            <h2 class="section-title">Your Learning Style</h2>
            <div class="learning-style-content">
                <div class="reading-score">
                    <div class="dominant-score-title" style="background-color: <%= @dominant_style[:color] %>"><%= @dominant_style[:name] %> Score: <%= @dominant_style[:score] %></div>
                    <div class="reading-widget">
                        <div class="chart-container" id="dominantChart"></div>
                    </div>
                </div>
                <div class="style-description">
                    <%= @learning_style_description.html_safe %>
                </div>
            </div>
        </div>

        <div class="other-scores-section">
            <h2 class="section-title">Your Other Scores</h2>
            <div class="scores-grid">
                <div class="score-item">
                    <div class="score-item-title visual-score-title">Visual Score: <%= @visual_score %></div>
                    <div class="score-item-widget">
                        <div class="small-chart-container" id="visualChart"></div>
                    </div>
                </div>
                <div class="score-item">
                    <div class="score-item-title auditory-score-title">Aural Score: <%= @aural_score %></div>
                    <div class="score-item-widget">
                        <div class="small-chart-container" id="auditoryChart"></div>
                    </div>
                </div>
                <div class="score-item">
                    <div class="score-item-title kinesthetic-score-title">Kinesthetic Score: <%= @kinesthetic_score %></div>
                    <div class="score-item-widget">
                        <div class="small-chart-container" id="kinestheticChart"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="signature-section">
            <div class="validation-text">Validated and approved</div>
            <div class="signature">John Doe</div>
            <div class="signature-name">John Doe</div>
            <div class="signature-title">Dean of Malang University</div>
        </div>
    </div>

<script>
    // Total Learning Score Chart
    var totalOptions = {
        series: <%= @percentages.to_json %>,
        chart: {
            height: 180,
            type: 'radialBar',
        },
        plotOptions: {
            radialBar: {
                offsetY: 0,
                startAngle: 0,
                endAngle: 270,
                hollow: {
                    margin: 5,
                    size: '30%',
                    background: 'transparent',
                    image: undefined,
                },
                dataLabels: {
                    name: {
                        show: false,
                    },
                    value: {
                        show: false,
                    }
                },
                barLabels: {
                    enabled: true,
                    useSeriesColors: true,
                    offsetX: -8,
                    fontSize: '12px',
                    formatter: function(seriesName, opts) {
                        var actualScores = <%= @scores.to_json %>;
                        return seriesName + ": " + actualScores[opts.seriesIndex];
                    },
                },
            }
        },
        colors: ['#8979FF', '#FF928A', '#3CC3DF', '#FFAE4C'],
        labels: ['Visual', 'Auditory', 'Reading', 'Kinesthetic'],
        responsive: [{
            breakpoint: 480,
            options: {
                legend: {
                    show: false
                }
            }
        }]
    };

    var totalChart = new ApexCharts(document.querySelector("#totalChart"), totalOptions);
    totalChart.render();

    // Dominant Style Chart
    var dominantOptions = {
        series: <%= @percentages.to_json %>,
        chart: {
            height: 180,
            type: 'radialBar',
        },
        plotOptions: {
            radialBar: {
                offsetY: 0,
                startAngle: 0,
                endAngle: 270,
                hollow: {
                    margin: 5,
                    size: '30%',
                    background: 'transparent',
                    image: undefined,
                },
                dataLabels: {
                    name: {
                        show: false,
                    },
                    value: {
                        show: false,
                    }
                },
                barLabels: {
                    enabled: true,
                    useSeriesColors: true,
                    offsetX: -8,
                    fontSize: '11px',
                    formatter: function(seriesName, opts) {
                        var actualScores = <%= @scores.to_json %>;
                        return seriesName + ": " + actualScores[opts.seriesIndex];
                    },
                },
            }
        },
        colors: <%= @dominant_style[:chart_colors].to_json %>,
        labels: ['Visual', 'Auditory', 'Reading', 'Kinesthetic']
    };

    var dominantChart = new ApexCharts(document.querySelector("#dominantChart"), dominantOptions);
    dominantChart.render();

    // Visual Score Chart
    var visualOptions = {
        series: <%= @percentages.to_json %>,
        chart: {
            height: 170,
            type: 'radialBar',
        },
        plotOptions: {
            radialBar: {
                offsetY: 0,
                startAngle: 0,
                endAngle: 270,
                hollow: {
                    margin: 5,
                    size: '30%',
                    background: 'transparent',
                    image: undefined,
                },
                dataLabels: {
                    name: {
                        show: false,
                    },
                    value: {
                        show: false,
                    }
                },
                barLabels: {
                    enabled: true,
                    useSeriesColors: true,
                    offsetX: -8,
                    fontSize: '10px',
                    formatter: function(seriesName, opts) {
                        var actualScores = <%= @scores.to_json %>;
                        return seriesName + ": " + actualScores[opts.seriesIndex];
                    },
                },
            }
        },
        colors: ['#8979FF', '#d3d3d3', '#d3d3d3', '#d3d3d3'],
        labels: ['Visual', 'Auditory', 'Reading', 'Kinesthetic']
    };

    var visualChart = new ApexCharts(document.querySelector("#visualChart"), visualOptions);
    visualChart.render();

    // Auditory Score Chart
    var auditoryOptions = {
        series: <%= @percentages.to_json %>,
        chart: {
            height: 170,
            type: 'radialBar',
        },
        plotOptions: {
            radialBar: {
                offsetY: 0,
                startAngle: 0,
                endAngle: 270,
                hollow: {
                    margin: 5,
                    size: '30%',
                    background: 'transparent',
                    image: undefined,
                },
                dataLabels: {
                    name: {
                        show: false,
                    },
                    value: {
                        show: false,
                    }
                },
                barLabels: {
                    enabled: true,
                    useSeriesColors: true,
                    offsetX: -8,
                    fontSize: '10px',
                    formatter: function(seriesName, opts) {
                        var actualScores = <%= @scores.to_json %>;
                        return seriesName + ": " + actualScores[opts.seriesIndex];
                    },
                },
            }
        },
        colors: ['#d3d3d3', '#FF928A', '#d3d3d3', '#d3d3d3'],
        labels: ['Visual', 'Auditory', 'Reading', 'Kinesthetic']
    };

    var auditoryChart = new ApexCharts(document.querySelector("#auditoryChart"), auditoryOptions);
    auditoryChart.render();

    // Kinesthetic Score Chart
    var kinestheticOptions = {
        series: <%= @percentages.to_json %>,
        chart: {
            height: 170,
            type: 'radialBar',
        },
        plotOptions: {
            radialBar: {
                offsetY: 0,
                startAngle: 0,
                endAngle: 270,
                hollow: {
                    margin: 5,
                    size: '30%',
                    background: 'transparent',
                    image: undefined,
                },
                dataLabels: {
                    name: {
                        show: false,
                    },
                    value: {
                        show: false,
                    }
                },
                barLabels: {
                    enabled: true,
                    useSeriesColors: true,
                    offsetX: -8,
                    fontSize: '10px',
                    formatter: function(seriesName, opts) {
                        var actualScores = <%= @scores.to_json %>;
                        return seriesName + ": " + actualScores[opts.seriesIndex];
                    },
                },
            }
        },
        colors: ['#d3d3d3', '#d3d3d3', '#d3d3d3', '#FFAE4C'],
        labels: ['Visual', 'Auditory', 'Reading', 'Kinesthetic']
    };

    var kinestheticChart = new ApexCharts(document.querySelector("#kinestheticChart"), kinestheticOptions);
    kinestheticChart.render();
</script>
</body>
</html>
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cakravia Official Score Report</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/apexcharts/4.7.0/apexcharts.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Merriweather+Sans:wght@300;400;700;800&display=swap');
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        @page {
            margin: 0;
            padding: 0;
            size: A4;
        }

        html, body {
            font-family: 'Merriweather Sans', 'Open Sans', 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
            margin: 0;
            padding: 0;
            color: #24348C;
            width: 100%;
            height: 100%;
            box-sizing: border-box;
        }

        *, h1, h2, h3, h4, h5, h6, p, div, span {
            font-family: 'Merriweather Sans', 'Open Sans', 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif !important;
            color: #24348C !important;
        }

        .header {
            background: #ABD305;
            color: #24348C;
            padding: 18px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: #9ed442;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: #24348C;
        }

        .logo-text {
            font-size: 16px;
            font-weight: bold;
        }

        .report-title {
            text-align: right;
        }

        .report-title h1 {
            font-size: 18px;
            margin-bottom: 3px;
        }

        .certificate-id {
            font-size: 10px;
            opacity: 0.9;
        }

        .main-content {
            padding: 0;
        }

        .certificate-section {
            background: url('<%= @background_image_path %>');
            background-size: cover;
            background-position: center;
            padding: 25px 30px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 0;
            position: relative;
        }

        .certificate-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: #DFE4FF;
            opacity: 0.8;
            z-index: 1;
        }

        .certificate-section > * {
            position: relative;
            z-index: 2;
        }

        .certificate-info {
            flex: 7;
        }

        .date {
            color: #24348C;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .certificate-title {
            font-size: 24px;
            color: #24348C;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .student-info {
            font-size: 14px;
            line-height: 1.4;
        }

        .student-info strong {
            color: #24348C;
        }

        .score-circle {
            width: 200px;
            height: 200px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            padding: 15px;
            position: relative;
            margin-left: 20px;
            flex-shrink: 0;
        }

        .score-widget {
            width: 100%;
            height: 100%;
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .chart-container {
            width: 180px;
            height: 180px;
        }

        .score-title {
            background: #9ed442;
            color: white;
            padding: 8px 24px;
            border-radius: 15px;
            font-size: 14px;
            font-weight: bold;
            position: absolute;
            top: -15px;
            left: 50%;
            transform: translateX(-50%);
            white-space: nowrap;
        }

        /* New Layout Styles */
        .learning-results-section {
            padding: 10px 30px;
            background: white;
            text-align: center;
        }

        .learning-style-header {
            margin-bottom: 30px;
        }

        .learning-style-main-title {
            font-size: 18px;
            color: #24348C;
            margin-bottom: 10px;
            font-weight: normal;
        }

        .learning-style-title {
            font-size: 22px;
            color: #24348C;
            font-weight: bold;
            margin-bottom: 30px;
        }

        .scores-container {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }

        .score-box {
            background-color: white;
            border: 2px solid;
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            min-width: 120px;
            max-width: 150px;
            position: relative;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .score-box.monitoring {
            border-color: #8979FF;
        }

        .score-box.action {
            border-color: #FF928A;
        }

        .score-box.happening {
            border-color: #3CC3DF;
        }

        .score-box.reflection {
            border-color: #FFAE4C;
        }

        .score-label {
            font-size: 12px;
            color: white;
            font-weight: bold;
            padding: 4px 12px;
            border-radius: 8px;
            position: absolute;
            top: -8px;
            left: 50%;
            transform: translateX(-50%);
            white-space: nowrap;
        }

        .score-label.monitoring {
            background-color: #8979FF;
        }

        .score-label.action {
            background-color: #FF928A;
        }

        .score-label.happening {
            background-color: #3CC3DF;
        }

        .score-label.reflection {
            background-color: #FFAE4C;
        }

        .score-value {
            font-size: 32px;
            font-weight: bold;
            color: #24348C;
            margin-top: 10px;
        }

        .description-section {
            margin-bottom: 30px;
            text-align: left;
        }

        .section-title {
            font-size: 16px;
            color: #24348C;
            font-weight: bold;
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 2px solid #24348C;
        }

        .section-content {
            line-height: 1.6;
            font-size: 13px;
            color: #24348C;
            text-align: justify;
        }

        .recommendation-section {
            background-color: #e8f0ff;
            border-radius: 12px;
            padding: 20px;
            text-align: left;
        }

        .recommendation-title {
            color: #24348C;
            font-size: 15px;
            font-weight: bold;
            margin-bottom: 12px;
        }

        .recommendation-content {
            font-size: 13px;
            line-height: 1.6;
            color: #24348C;
            text-align: justify;
        }

        .signature-section {
            text-align: center;
            padding: 8px 30px 5px 30px;
            border-top: 1px solid #e9ecef;
            background: white;
        }

        .validation-text {
            font-size: 11px;
            color: #24348C;
            margin-bottom: 15px;
        }

        .signature {
            font-size: 20px;
            font-style: italic;
            color: #24348C;
            margin-bottom: 8px;
        }

        .signature-image {
            margin-bottom: 8px;
        }

        .signature-image img {
            max-width: 120px;
            max-height: 35px;
            object-fit: contain;
        }

        .signature-name {
            font-weight: bold;
            color: #24348C;
        }

        .signature-title {
            font-size: 11px;
            color: #24348C;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo">
            <div class="logo-icon">b</div>
            <div class="logo-text">logoipsum</div>
        </div>
        <div class="report-title">
            <h1>Cakravia Official Score Report</h1>
            <div class="certificate-id">Certificate ID: <%= @certificate_id %></div>
        </div>
    </div>

    <div class="main-content">
        <div class="certificate-section">
            <div class="certificate-info">
                <div class="date"><%= @current_date %></div>
                <h2 class="certificate-title">Certificate of Completion</h2>
                <div class="student-info">
                    <div><strong>Name:</strong> <%= @user_name %></div>
                    <div><strong>Date of Birth:</strong> <%= @birth_date %></div>
                    <div><strong>Test Date:</strong> <%= @test_date %></div>
                </div>
            </div>
            <div class="score-circle total-score">
                <div class="score-title">Total Learning Score</div>
                <div class="score-widget">
                    <div class="chart-container" id="totalChart"></div>
                </div>
            </div>
        </div>

        <div class="learning-results-section">
            <div class="learning-style-header">
                <div class="learning-style-main-title">Your Behavioral Learning Style</div>
                <div class="learning-style-title"><%= @learning_style_title %></div>
            </div>

            <div class="scores-container">
                <!-- Show all four behavioral learning scores -->
                <div class="score-box monitoring">
                    <div class="score-label monitoring">Monitoring Score</div>
                    <div class="score-value"><%= @m_score %></div>
                </div>
                <div class="score-box action">
                    <div class="score-label action">Action Score</div>
                    <div class="score-value"><%= @a_score %></div>
                </div>
                <div class="score-box happening">
                    <div class="score-label happening">Happening Score</div>
                    <div class="score-value"><%= @h_score %></div>
                </div>
                <div class="score-box reflection">
                    <div class="score-label reflection">Reflection Score</div>
                    <div class="score-value"><%= @r_score %></div>
                </div>
            </div>

            <div class="description-section">
                <div class="section-title">Deskripsi Kemampuan</div>
                <div class="section-content">
                    <% if @description %>
                        <%= @description %>
                    <% else %>
                        <p>Hasil tes behavioral learning menunjukkan preferensi Anda dalam gaya pembelajaran berdasarkan kategori Monitoring, Action, Happening, dan Reflection. Setiap kategori mencerminkan cara Anda memproses informasi dan mengembangkan kemampuan.</p>
                    <% end %>
                </div>
            </div>

            <div class="recommendation-section">
                <div class="recommendation-title">Rekomendasi Pembelajaran</div>
                <div class="recommendation-content">
                    <% if @study_recommendations %>
                        <%= @study_recommendations %>
                    <% else %>
                        <p>Berdasarkan hasil tes, fokuskan pembelajaran pada kategori yang mendominasi. Manfaatkan kekuatan Anda dalam kategori tersebut untuk meningkatkan efektivitas belajar dan kembangkan area yang perlu diperkuat.</p>
                    <% end %>
                </div>
            </div>
        </div>

        <div class="signature-section">
            <div class="validation-text">Validated and approved</div>
            <% if @has_signature_image %>
            <div class="signature-image">
                <img src="<%= @signature_image_path %>" alt="Signature" style="max-width: 120px; max-height: 35px;">
            </div>
            <% else %>
            <div class="signature"><%= @signature_name %></div>
            <% end %>
            <div class="signature-name"><%= @signature_name %></div>
            <div class="signature-title"><%= @signature_title %></div>
        </div>
    </div>

<script>
    // Total Learning Score Chart
    var totalOptions = {
        series: <%= @percentages.to_json %>,
        chart: {
            height: 180,
            width: 180,
            type: 'radialBar',
        },
        plotOptions: {
            radialBar: {
                offsetY: 0,
                startAngle: 0,
                endAngle: 270,
                hollow: {
                    margin: 5,
                    size: '30%',
                    background: 'transparent',
                    image: undefined,
                },
                dataLabels: {
                    name: {
                        show: false,
                    },
                    value: {
                        show: false,
                    }
                },
                barLabels: {
                    enabled: true,
                    useSeriesColors: true,
                    offsetX: -8,
                    fontSize: '9px',
                    formatter: function(seriesName, opts) {
                        var actualScores = <%= @scores.to_json %>;
                        return seriesName + ": " + actualScores[opts.seriesIndex];
                    },
                },
            }
        },
        colors: ['#8979FF', '#FF928A', '#3CC3DF', '#FFAE4C'],
        labels: ['Monitoring', 'Action', 'Happening', 'Reflection'],
        responsive: [{
            breakpoint: 480,
            options: {
                legend: {
                    show: false
                }
            }
        }]
    };

    // Wait for DOM to be ready
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof ApexCharts !== 'undefined') {
            var totalChart = new ApexCharts(document.querySelector("#totalChart"), totalOptions);
            totalChart.render();
        } else {
            console.log('ApexCharts not loaded');
        }
    });
</script>
</body>
</html>
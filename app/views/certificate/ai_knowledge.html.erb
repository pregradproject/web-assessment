<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cakravia AI Knowledge Assessment Score Report</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/apexcharts/4.7.0/apexcharts.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Merriweather+Sans:wght@300;400;700;800&display=swap');
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        @page {
            margin: 0;
            padding: 0;
            size: A4;
        }

        html, body {
            font-family: 'Merriweather Sans', 'Open Sans', 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
            margin: 0;
            padding: 0;
            color: #24348C;
            width: 100%;
            height: 100%;
            box-sizing: border-box;
        }

        *, h1, h2, h3, h4, h5, h6, p, div, span {
            font-family: 'Merriweather Sans', 'Open Sans', 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif !important;
            color: #24348C !important;
        }

        .header {
            background: #ABD305;
            color: #24348C;
            padding: 18px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-text {
            font-size: 16px;
            font-weight: bold;
        }

        .report-title {
            text-align: right;
        }

        .report-title h1 {
            font-size: 18px;
            margin-bottom: 3px;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: #9ed442;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: #24348C;
        }

        .certificate-id {
            font-size: 10px;
            opacity: 0.9;
        }

        .main-content {
            padding: 0;
        }

        .certificate-section {
            background: url('<%= @background_image_path %>');
            background-size: cover;
            background-position: center;
            padding: 25px 30px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 0;
            position: relative;
        }

        .certificate-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: #DFE4FF;
            opacity: 0.8;
            z-index: 1;
        }

        .certificate-section > * {
            position: relative;
            z-index: 2;
        }

        .certificate-info {
            flex: 7;
        }

        .date {
            color: #24348C;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .certificate-title {
            font-size: 24px;
            color: #24348C;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .student-info {
            font-size: 14px;
            line-height: 1.4;
        }

        .student-info strong {
            color: #24348C;
        }

        .score-circle {
            width: 200px;
            height: 200px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            padding: 15px;
            position: relative;
            margin-left: 20px;
            flex-shrink: 0;
        }

        .score-widget {
            width: 100%;
            height: 100%;
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .chart-container {
            width: 180px;
            height: 180px;
        }

        .score-title {
            background: #9ed442;
            color: white;
            padding: 8px 24px;
            border-radius: 15px;
            font-size: 14px;
            font-weight: bold;
            position: absolute;
            top: -15px;
            left: 50%;
            transform: translateX(-50%);
            white-space: nowrap;
        }

        /* New Layout Styles */
        .learning-results-section {
            padding: 10px 30px;
            background: white;
            text-align: center;
        }

        .learning-style-header {
            margin-bottom: 30px;
        }

        .learning-style-main-title {
            font-size: 18px;
            color: #24348C;
            margin-bottom: 10px;
            font-weight: normal;
        }

        .learning-style-title {
            font-size: 22px;
            color: #24348C;
            font-weight: bold;
            margin-bottom: 30px;
        }

        .scores-container {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }

        .score-box {
            background-color: white;
            border: 2px solid;
            border-radius: 12px;
            padding: 15px 10px;
            text-align: center;
            min-width: 100px;
            max-width: 110px;
            position: relative;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .score-box.pe {
            border-color: #8979FF;
        }

        .score-box.ee {
            border-color: #FF928A;
        }

        .score-box.si {
            border-color: #3CC3DF;
        }

        .score-box.fc {
            border-color: #FFAE4C;
        }

        .score-box.hm {
            border-color: #FF6B9D;
        }

        .score-box.pv {
            border-color: #4ECDC4;
        }

        .score-box.ht {
            border-color: #A8E6CF;
        }

        .score-box.bi {
            border-color: #FFD93D;
        }

        .score-label {
            font-size: 10px;
            color: white;
            font-weight: bold;
            padding: 3px 6px;
            border-radius: 8px;
            position: absolute;
            top: -8px;
            left: 50%;
            transform: translateX(-50%);
            white-space: nowrap;
        }

        .score-label.pe {
            background-color: #8979FF;
        }

        .score-label.ee {
            background-color: #FF928A;
        }

        .score-label.si {
            background-color: #3CC3DF;
        }

        .score-label.fc {
            background-color: #FFAE4C;
        }

        .score-label.hm {
            background-color: #FF6B9D;
        }

        .score-label.pv {
            background-color: #4ECDC4;
        }

        .score-label.ht {
            background-color: #A8E6CF;
        }

        .score-label.bi {
            background-color: #FFD93D;
        }

        .score-value {
            font-size: 24px;
            font-weight: bold;
            color: #24348C;
            margin-top: 10px;
        }

        .description-section {
            margin-bottom: 30px;
            text-align: left;
        }

        .section-title {
            font-size: 16px;
            color: #24348C;
            font-weight: bold;
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 2px solid #24348C;
        }

        .section-content {
            line-height: 1.6;
            font-size: 13px;
            color: #24348C;
            text-align: justify;
        }

        .recommendation-section {
            background-color: #e8f0ff;
            border-radius: 12px;
            padding: 20px;
            text-align: left;
        }

        .recommendation-title {
            color: #24348C;
            font-size: 15px;
            font-weight: bold;
            margin-bottom: 12px;
        }

        .recommendation-content {
            font-size: 13px;
            line-height: 1.6;
            color: #24348C;
            text-align: justify;
        }

        .signature-section {
            text-align: center;
            padding: 8px 30px 5px 30px;
            border-top: 1px solid #e9ecef;
            background: white;
        }

        .validation-text {
            font-size: 11px;
            color: #24348C;
            margin-bottom: 15px;
        }

        .signature {
            font-size: 20px;
            font-style: italic;
            color: #24348C;
            margin-bottom: 8px;
        }

        .signature-image {
            margin-bottom: 8px;
        }

        .signature-image img {
            max-width: 120px;
            max-height: 35px;
            object-fit: contain;
        }

        .signature-name {
            font-weight: bold;
            color: #24348C;
        }

        .signature-title {
            font-size: 11px;
            color: #24348C;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo">
            <div class="logo-icon">b</div>
            <div class="logo-text">logoipsum</div>
        </div>
        <div class="report-title">
            <h1>Cakravia Official Score Report</h1>
            <div class="certificate-id">Certificate ID: <%= @certificate_id %></div>
        </div>
    </div>

    <div class="main-content">
        <div class="certificate-section">
            <div class="certificate-info">
                <div class="date"><%= @current_date %></div>
                <h2 class="certificate-title">Certificate of Completion</h2>
                <div class="student-info">
                    <div><strong>Name:</strong> <%= @user_name %></div>
                    <div><strong>Date of Birth:</strong> <%= @birth_date %></div>
                    <div><strong>Test Date:</strong> <%= @test_date %></div>
                </div>
            </div>
            <div class="score-circle total-score">
                <div class="score-title">AI Knowledge Score</div>
                <div class="score-widget">
                    <div class="chart-container" id="totalChart"></div>
                </div>
            </div>
        </div>

        <div class="learning-results-section">
            <div class="learning-style-header">
                <div class="learning-style-main-title">Your AI Knowledge Assessment Results</div>
                <div class="learning-style-title"><%= @learning_style_title %></div>
            </div>

            <div class="scores-container">
                <!-- Show all eight AI knowledge scores -->
                <div class="score-box pe">
                    <div class="score-label pe">Performance Expectancy</div>
                    <div class="score-value"><%= @performance_expectancy_score %></div>
                </div>
                <div class="score-box ee">
                    <div class="score-label ee">Effort Expectancy</div>
                    <div class="score-value"><%= @effort_expectancy_score %></div>
                </div>
                <div class="score-box si">
                    <div class="score-label si">Social Influence</div>
                    <div class="score-value"><%= @social_influence_score %></div>
                </div>
                <div class="score-box fc">
                    <div class="score-label fc">Facilitating Conditions</div>
                    <div class="score-value"><%= @facilitating_conditions_score %></div>
                </div>
                <div class="score-box hm">
                    <div class="score-label hm">Hedonic Motivation</div>
                    <div class="score-value"><%= @hedonic_motivation_score %></div>
                </div>
                <div class="score-box pv">
                    <div class="score-label pv">Price Value</div>
                    <div class="score-value"><%= @price_value_score %></div>
                </div>
                <div class="score-box ht">
                    <div class="score-label ht">Habit</div>
                    <div class="score-value"><%= @habit_score %></div>
                </div>
                <div class="score-box bi">
                    <div class="score-label bi">Behavioral Intention</div>
                    <div class="score-value"><%= @behavioral_intention_score %></div>
                </div>
            </div>

            <div class="description-section">
                <div class="section-title">Assessment Description</div>
                <div class="section-content">
                    <% if @description %>
                        <%= @description %>
                    <% else %>
                        <p>Your AI Knowledge assessment results show your understanding and attitudes towards artificial intelligence across eight key dimensions: Performance Expectancy (PE), Effort Expectancy (EE), Social Influence (SI), Facilitating Conditions (FC), Hedonic Motivation (HM), Price Value (PV), Habit (HT), and Behavioral Intention (BI).</p>
                    <% end %>
                </div>
            </div>

            <div class="recommendation-section">
                <div class="recommendation-title">Development Recommendations</div>
                <div class="recommendation-content">
                    <% if @study_recommendations %>
                        <%= @study_recommendations %>
                    <% else %>
                        <p>Based on your assessment results, focus on strengthening areas with lower scores while leveraging your strengths in AI knowledge and application. Consider additional training or resources to enhance your understanding and confidence in using AI technologies.</p>
                    <% end %>
                </div>
            </div>
        </div>

        <div class="signature-section">
            <div class="validation-text">Validated and approved</div>
            <% if @has_signature_image %>
            <div class="signature-image">
                <img src="<%= @signature_image_path %>" alt="Signature" style="max-width: 120px; max-height: 35px;">
            </div>
            <% else %>
            <div class="signature"><%= @signature_name %></div>
            <% end %>
            <div class="signature-name"><%= @signature_name %></div>
            <div class="signature-title"><%= @signature_title %></div>
        </div>
    </div>

    <script>
        // AI Knowledge Radar Chart
        var aiKnowledgeOptions = {
            series: [{
                name: 'AI Knowledge Score',
                data: <%= @scores.to_json.html_safe %>
            }],
            chart: {
                height: 180,
                width: 180,
                type: 'radar',
                toolbar: { show: false },
                animations: { enabled: false }
            },
            xaxis: {
                categories: ['PE', 'EE', 'SI', 'FC', 'HM', 'PV', 'HT', 'BI']
            },
            yaxis: {
                show: false,
                min: 0,
                max: function(max) {
                    return Math.ceil(max * 1.1);
                }
            },
            colors: ['#ABD305'],
            fill: {
                opacity: 0.2
            },
            stroke: {
                show: true,
                width: 2,
                colors: ['#ABD305'],
                dashArray: 0
            },
            markers: {
                size: 4,
                colors: ['#ABD305'],
                strokeColor: '#ABD305',
                strokeWidth: 2
            },
            plotOptions: {
                radar: {
                    size: 80,
                    polygons: {
                        strokeColors: '#e9ecef',
                        fill: {
                            colors: ['#f8f9fa', '#ffffff']
                        }
                    }
                }
            },
            dataLabels: {
                enabled: true,
                background: {
                    enabled: true,
                    foreColor: '#fff',
                    padding: 2,
                    borderRadius: 2,
                    borderWidth: 1,
                    borderColor: '#ABD305',
                    opacity: 0.9,
                    dropShadow: {
                        enabled: false
                    }
                },
                style: {
                    fontSize: '8px',
                    colors: ['#ABD305']
                },
                formatter: function(val) {
                    return val.toFixed(1);
                }
            },
            legend: { show: false },
            responsive: [{
                breakpoint: 480,
                options: {
                    legend: {
                        show: false
                    }
                }
            }]
        };

        // Wait for DOM to be ready
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof ApexCharts !== 'undefined') {
                var aiKnowledgeChart = new ApexCharts(document.querySelector("#totalChart"), aiKnowledgeOptions);
                aiKnowledgeChart.render();
            } else {
                console.log('ApexCharts not loaded');
            }
        });
    </script>
</body>
</html>
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cakravia AI Knowledge Assessment Score Report</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/apexcharts/4.7.0/apexcharts.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Merriweather+Sans:wght@300;400;700;800&display=swap');
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        @page {
            margin: 0;
            padding: 0;
            size: A4;
        }

        html, body {
            font-family: 'Merriweather Sans', 'Open Sans', 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
            margin: 0;
            padding: 0;
            color: #24348C;
            width: 100%;
            height: 100%;
            box-sizing: border-box;
        }

        *, h1, h2, h3, h4, h5, h6, p, div, span {
            font-family: 'Merriweather Sans', 'Open Sans', 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif !important;
            color: #24348C !important;
        }

        .header {
            background: #ABD305;
            color: #24348C;
            padding: 18px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-text {
            font-size: 20px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .report-title {
            font-size: 18px;
            font-weight: 400;
            text-align: center;
        }

        .container {
            padding: 30px;
            max-width: 800px;
            margin: 0 auto;
        }

        .participant-info {
            background: #F8F9FA;
            border: 2px solid #E9ECEF;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 30px;
        }

        .participant-info h2 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 20px;
            text-align: center;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .info-item {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #DEE2E6;
        }

        .info-label {
            font-weight: 600;
            color: #495057;
        }

        .info-value {
            font-weight: 400;
            color: #24348C;
        }

        .results-section {
            margin: 30px 0;
        }

        .section-title {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 20px;
            text-align: center;
            color: #24348C;
        }

        .scores-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 30px;
        }

        .score-card {
            background: white;
            border: 2px solid #E9ECEF;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            transition: all 0.3s ease;
        }

        .score-card.dominant {
            border-color: #ABD305;
            background: #F8FDE7;
        }

        .score-label {
            font-size: 12px;
            font-weight: 600;
            color: #6C757D;
            margin-bottom: 5px;
        }

        .score-value {
            font-size: 20px;
            font-weight: 800;
            color: #24348C;
        }

        .chart-container {
            width: 100%;
            height: 300px;
            margin: 30px 0;
            display: flex;
            justify-content: center;
        }

        .result-description {
            background: #F8F9FA;
            border-left: 4px solid #ABD305;
            padding: 25px;
            margin: 30px 0;
            border-radius: 0 8px 8px 0;
        }

        .result-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 15px;
            color: #24348C;
        }

        .result-content {
            font-size: 14px;
            line-height: 1.6;
            color: #495057;
        }

        .signature-section {
            margin-top: 50px;
            display: flex;
            justify-content: space-between;
            align-items: end;
        }

        .signature-left {
            text-align: left;
        }

        .signature-right {
            text-align: center;
        }

        .signature-image {
            max-width: 120px;
            max-height: 60px;
            margin-bottom: 10px;
        }

        .signature-name {
            font-weight: 700;
            font-size: 14px;
            border-top: 1px solid #24348C;
            padding-top: 5px;
            margin-top: 20px;
        }

        .signature-title {
            font-size: 12px;
            color: #6C757D;
            margin-top: 2px;
        }

        .footer {
            margin-top: 40px;
            text-align: center;
            font-size: 12px;
            color: #6C757D;
            border-top: 1px solid #E9ECEF;
            padding-top: 15px;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo">
            <div class="logo-text">CAKRAVIA</div>
        </div>
        <div class="report-title">AI Knowledge Assessment - Official Score Report</div>
    </div>

    <div class="container">
        <!-- Participant Information -->
        <div class="participant-info">
            <h2>Informasi Peserta</h2>
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">Nama:</span>
                    <span class="info-value"><%= @user_name %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Tanggal Lahir:</span>
                    <span class="info-value"><%= @birth_date %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Tanggal Tes:</span>
                    <span class="info-value"><%= @test_date %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">ID Sertifikat:</span>
                    <span class="info-value"><%= @certificate_id %></span>
                </div>
            </div>
        </div>

        <!-- AI Knowledge Scores -->
        <div class="results-section">
            <h3 class="section-title">Hasil AI Knowledge Assessment</h3>
            <div class="scores-grid">
                <div class="score-card">
                    <div class="score-label">Performance Expectancy</div>
                    <div class="score-value"><%= @performance_expectancy_score %></div>
                </div>
                <div class="score-card">
                    <div class="score-label">Effort Expectancy</div>
                    <div class="score-value"><%= @effort_expectancy_score %></div>
                </div>
                <div class="score-card">
                    <div class="score-label">Social Influence</div>
                    <div class="score-value"><%= @social_influence_score %></div>
                </div>
                <div class="score-card">
                    <div class="score-label">Facilitating Conditions</div>
                    <div class="score-value"><%= @facilitating_conditions_score %></div>
                </div>
                <div class="score-card">
                    <div class="score-label">Hedonic Motivation</div>
                    <div class="score-value"><%= @hedonic_motivation_score %></div>
                </div>
                <div class="score-card">
                    <div class="score-label">Price Value</div>
                    <div class="score-value"><%= @price_value_score %></div>
                </div>
                <div class="score-card">
                    <div class="score-label">Habit</div>
                    <div class="score-value"><%= @habit_score %></div>
                </div>
                <div class="score-card">
                    <div class="score-label">Behavioral Intention</div>
                    <div class="score-value"><%= @behavioral_intention_score %></div>
                </div>
            </div>

            <!-- Chart Container -->
            <div class="chart-container">
                <div id="aiKnowledgeChart"></div>
            </div>
        </div>

        <!-- Result Description -->
        <div class="result-description">
            <div class="result-title"><%= @learning_style_title %></div>
            <div class="result-content">
                <p><strong>Deskripsi:</strong> <%= @description %></p>
                <% if @study_recommendations %>
                <p><strong>Rekomendasi:</strong> <%= @study_recommendations %></p>
                <% end %>
            </div>
        </div>

        <!-- Signature Section -->
        <div class="signature-section">
            <div class="signature-left">
                <div style="font-size: 12px; color: #6C757D;">
                    Tanggal Terbit: <%= @current_date %><br>
                    Sertifikat ini dihasilkan secara otomatis oleh sistem Cakravia
                </div>
            </div>
            <div class="signature-right">
                <% if @has_signature_image %>
                    <img src="<%= @signature_image_path %>" alt="Signature" class="signature-image">
                <% end %>
                <div class="signature-name"><%= @signature_name %></div>
                <div class="signature-title"><%= @signature_title %></div>
            </div>
        </div>

        <div class="footer">
            <p>© 2024 Cakravia. Semua hak dilindungi undang-undang.</p>
            <p>Sertifikat ini sah dan dapat diverifikasi melalui sistem Cakravia.</p>
        </div>
    </div>

    <script>
        // AI Knowledge Chart
        const aiKnowledgeOptions = {
            chart: {
                type: 'bar',
                height: 300,
                toolbar: { show: false },
                animations: { enabled: false }
            },
            series: [{
                name: 'Score',
                data: <%= @scores.to_json.html_safe %>
            }],
            xaxis: {
                categories: ['PE', 'EE', 'SI', 'FC', 'HM', 'PV', 'HT', 'BI'],
                title: { text: 'AI Knowledge Components' }
            },
            yaxis: {
                title: { text: 'Score' }
            },
            colors: ['#8979FF', '#FF928A', '#3CC3DF', '#FFAE4C', '#9B59B6', '#E67E22', '#2ECC71', '#E74C3C'],
            plotOptions: {
                bar: {
                    distributed: true,
                    borderRadius: 4
                }
            },
            dataLabels: {
                enabled: true,
                formatter: function(val) {
                    return val.toFixed(1);
                }
            },
            legend: { show: false },
            title: {
                text: 'AI Knowledge Assessment Results',
                align: 'center',
                style: { fontSize: '16px', fontWeight: 'bold', color: '#24348C' }
            }
        };

        const aiKnowledgeChart = new ApexCharts(document.querySelector("#aiKnowledgeChart"), aiKnowledgeOptions);
        aiKnowledgeChart.render();

        // Print-ready styling
        window.addEventListener('beforeprint', function() {
            document.body.style.background = 'white';
        });
    </script>
</body>
</html>
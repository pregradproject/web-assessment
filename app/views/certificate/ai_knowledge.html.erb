<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cakravia AI Knowledge Assessment Score Report</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/apexcharts/4.7.0/apexcharts.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Merriweather+Sans:wght@300;400;700;800&display=swap');
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        @page {
            margin: 0;
            padding: 0;
            size: A4;
        }

        html, body {
            font-family: 'Merriweather Sans', 'Open Sans', 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
            margin: 0;
            padding: 0;
            color: #24348C;
            width: 100%;
            height: 100%;
            box-sizing: border-box;
        }

        *, h1, h2, h3, h4, h5, h6, p, div, span {
            font-family: 'Merriweather Sans', 'Open Sans', 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif !important;
            color: #24348C !important;
        }

        .header {
            background: #ABD305;
            color: #24348C;
            padding: 18px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-text {
            font-size: 20px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .report-title {
            font-size: 18px;
            font-weight: 400;
            text-align: center;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: #9ed442;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: #24348C;
        }

        .certificate-id {
            font-size: 10px;
            opacity: 0.9;
        }

        .main-content {
            padding: 0;
        }

        .certificate-section {
            background: url('<%= @background_image_path %>');
            background-size: cover;
            background-position: center;
            padding: 25px 30px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 0;
            position: relative;
        }

        .certificate-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: #DFE4FF;
            opacity: 0.8;
            z-index: 1;
        }

        .certificate-section > * {
            position: relative;
            z-index: 2;
        }

        .certificate-info {
            flex: 7;
        }

        .date {
            color: #24348C;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .certificate-title {
            font-size: 24px;
            color: #24348C;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .student-info {
            font-size: 14px;
            line-height: 1.4;
        }

        .student-info strong {
            color: #24348C;
        }

        .score-circle {
            width: 200px;
            height: 200px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            padding: 15px;
            position: relative;
            margin-left: 20px;
            flex-shrink: 0;
        }

        .score-widget {
            width: 100%;
            height: 100%;
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .score-title {
            background: #9ed442;
            color: white;
            padding: 8px 24px;
            border-radius: 15px;
            font-size: 14px;
            font-weight: bold;
            position: absolute;
            top: -15px;
            left: 50%;
            transform: translateX(-50%);
            white-space: nowrap;
        }

        .container {
            padding: 30px;
            max-width: 800px;
            margin: 0 auto;
        }

        .results-section {
            margin: 30px 0;
        }

        .section-title {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 20px;
            text-align: center;
            color: #24348C;
        }

        .scores-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 30px;
        }

        .score-card {
            background: white;
            border: 2px solid #E9ECEF;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            transition: all 0.3s ease;
        }

        .score-card.dominant {
            border-color: #ABD305;
            background: #F8FDE7;
        }

        .score-label {
            font-size: 12px;
            font-weight: 600;
            color: #6C757D;
            margin-bottom: 5px;
        }

        .score-value {
            font-size: 20px;
            font-weight: 800;
            color: #24348C;
        }

        .chart-container {
            width: 180px;
            height: 180px;
        }

        .result-description {
            background: #F8F9FA;
            border-left: 4px solid #ABD305;
            padding: 25px;
            margin: 30px 0;
            border-radius: 0 8px 8px 0;
        }

        .result-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 15px;
            color: #24348C;
        }

        .result-content {
            font-size: 14px;
            line-height: 1.6;
            color: #495057;
        }

        .signature-section {
            margin-top: 50px;
            display: flex;
            justify-content: space-between;
            align-items: end;
        }

        .signature-left {
            text-align: left;
        }

        .signature-right {
            text-align: center;
        }

        .signature-image {
            max-width: 120px;
            max-height: 60px;
            margin-bottom: 10px;
        }

        .signature-name {
            font-weight: 700;
            font-size: 14px;
            border-top: 1px solid #24348C;
            padding-top: 5px;
            margin-top: 20px;
        }

        .signature-title {
            font-size: 12px;
            color: #6C757D;
            margin-top: 2px;
        }

        .footer {
            margin-top: 40px;
            text-align: center;
            font-size: 12px;
            color: #6C757D;
            border-top: 1px solid #E9ECEF;
            padding-top: 15px;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo">
            <div class="logo-icon">b</div>
            <div class="logo-text">logoipsum</div>
        </div>
        <div class="report-title">
            <h1>Cakravia Official Score Report</h1>
            <div class="certificate-id">Certificate ID: <%= @certificate_id %></div>
        </div>
    </div>

    <div class="main-content">
        <div class="certificate-section">
            <div class="certificate-info">
                <div class="date"><%= @current_date %></div>
                <h2 class="certificate-title">Certificate of Completion</h2>
                <div class="student-info">
                    <div><strong>Name:</strong> <%= @user_name %></div>
                    <div><strong>Date of Birth:</strong> <%= @birth_date %></div>
                    <div><strong>Test Date:</strong> <%= @test_date %></div>
                </div>
            </div>
            <div class="score-circle total-score">
                <div class="score-title">AI Knowledge Score</div>
                <div class="score-widget">
                    <div class="chart-container" id="aiKnowledgeChart"></div>
                </div>
            </div>
        </div>

        <div class="container">

        <!-- AI Knowledge Scores -->
        <div class="results-section">
            <h3 class="section-title">Hasil AI Knowledge Assessment</h3>
            <div class="scores-grid">
                <div class="score-card">
                    <div class="score-label">Performance Expectancy</div>
                    <div class="score-value"><%= @performance_expectancy_score %></div>
                </div>
                <div class="score-card">
                    <div class="score-label">Effort Expectancy</div>
                    <div class="score-value"><%= @effort_expectancy_score %></div>
                </div>
                <div class="score-card">
                    <div class="score-label">Social Influence</div>
                    <div class="score-value"><%= @social_influence_score %></div>
                </div>
                <div class="score-card">
                    <div class="score-label">Facilitating Conditions</div>
                    <div class="score-value"><%= @facilitating_conditions_score %></div>
                </div>
                <div class="score-card">
                    <div class="score-label">Hedonic Motivation</div>
                    <div class="score-value"><%= @hedonic_motivation_score %></div>
                </div>
                <div class="score-card">
                    <div class="score-label">Price Value</div>
                    <div class="score-value"><%= @price_value_score %></div>
                </div>
                <div class="score-card">
                    <div class="score-label">Habit</div>
                    <div class="score-value"><%= @habit_score %></div>
                </div>
                <div class="score-card">
                    <div class="score-label">Behavioral Intention</div>
                    <div class="score-value"><%= @behavioral_intention_score %></div>
                </div>
            </div>

            <!-- Chart Container -->
            <div class="chart-container">
                <div id="aiKnowledgeChart"></div>
            </div>
        </div>

        <!-- Result Description -->
        <div class="result-description">
            <div class="result-title"><%= @learning_style_title %></div>
            <div class="result-content">
                <p><strong>Deskripsi:</strong> <%= @description %></p>
                <% if @study_recommendations %>
                <p><strong>Rekomendasi:</strong> <%= @study_recommendations %></p>
                <% end %>
            </div>
        </div>

        <!-- Signature Section -->
        <div class="signature-section">
            <div class="signature-left">
                <div style="font-size: 12px; color: #6C757D;">
                    Tanggal Terbit: <%= @current_date %><br>
                    Sertifikat ini dihasilkan secara otomatis oleh sistem Cakravia
                </div>
            </div>
            <div class="signature-right">
                <% if @has_signature_image %>
                    <img src="<%= @signature_image_path %>" alt="Signature" class="signature-image">
                <% end %>
                <div class="signature-name"><%= @signature_name %></div>
                <div class="signature-title"><%= @signature_title %></div>
            </div>
        </div>

            <div class="footer">
                <p>© 2024 Cakravia. Semua hak dilindungi undang-undang.</p>
                <p>Sertifikat ini sah dan dapat diverifikasi melalui sistem Cakravia.</p>
            </div>
        </div>
    </div>

    <script>
        // AI Knowledge Radar Chart
        var aiKnowledgeOptions = {
            series: [{
                name: 'AI Knowledge Score',
                data: <%= @scores.to_json.html_safe %>
            }],
            chart: {
                height: 180,
                width: 180,
                type: 'radar',
                toolbar: { show: false },
                animations: { enabled: false }
            },
            xaxis: {
                categories: ['PE', 'EE', 'SI', 'FC', 'HM', 'PV', 'HT', 'BI']
            },
            yaxis: {
                show: false,
                min: 0,
                max: function(max) {
                    return Math.ceil(max * 1.1);
                }
            },
            colors: ['#ABD305'],
            fill: {
                opacity: 0.2
            },
            stroke: {
                show: true,
                width: 2,
                colors: ['#ABD305'],
                dashArray: 0
            },
            markers: {
                size: 4,
                colors: ['#ABD305'],
                strokeColor: '#ABD305',
                strokeWidth: 2
            },
            plotOptions: {
                radar: {
                    size: 80,
                    polygons: {
                        strokeColors: '#e9ecef',
                        fill: {
                            colors: ['#f8f9fa', '#ffffff']
                        }
                    }
                }
            },
            dataLabels: {
                enabled: true,
                background: {
                    enabled: true,
                    foreColor: '#fff',
                    padding: 2,
                    borderRadius: 2,
                    borderWidth: 1,
                    borderColor: '#ABD305',
                    opacity: 0.9,
                    dropShadow: {
                        enabled: false
                    }
                },
                style: {
                    fontSize: '8px',
                    colors: ['#ABD305']
                },
                formatter: function(val) {
                    return val.toFixed(1);
                }
            },
            legend: { show: false },
            responsive: [{
                breakpoint: 480,
                options: {
                    legend: {
                        show: false
                    }
                }
            }]
        };

        // Wait for DOM to be ready
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof ApexCharts !== 'undefined') {
                var aiKnowledgeChart = new ApexCharts(document.querySelector("#aiKnowledgeChart"), aiKnowledgeOptions);
                aiKnowledgeChart.render();
            } else {
                console.log('ApexCharts not loaded');
            }
        });

        // Print-ready styling
        window.addEventListener('beforeprint', function() {
            document.body.style.background = 'white';
        });
    </script>
</body>
</html>